{
  "language": "Python 3.11+ / HTML / CSS / JavaScript",
  "project_shape": "fullstack",
  "source_extensions": [
    ".py",
    ".html",
    ".css",
    ".js"
  ],
  "testing": "deferred",
  "build_command": "python3 -m compileall -q loopsill",
